<?xml version="1.0" encoding="utf-8"?>
<!--
  The same theme at night, spelled out rather than inherited.

  Dark or light here is WinBoard's own setting and not the system's - a keyboard that flipped
  to white because the phone turned its own dark mode off would be overriding a choice
  somebody made on this app's own page - so both configurations get the same window
  background, which is the colour the page paints over in either case.
-->
<resources>

    <style name="Theme.WinBoard" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Activity</item>
    </style>

</resources>
