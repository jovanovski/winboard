<?xml version="1.0" encoding="utf-8"?>
<!--
  No <monochrome>: the mark is a four-colour flag and a themed icon is drawn in one colour,
  which would leave a silhouette of its black outline and nothing else. Launchers that ask
  for a themed icon and do not get one fall back to this, which is the honest answer.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
