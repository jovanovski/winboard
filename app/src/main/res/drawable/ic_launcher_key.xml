<?xml version="1.0" encoding="utf-8"?>
<!--
  One Windows 98 key, with nothing on it.

  The face and the two bands either side of it, drawn the way `KeyboardTheme.Win98` draws a
  raised button: white and #E9E7E3 down the top and left, #8D8985 and near-black down the
  bottom and right. The flag goes on top of it - see ic_launcher_foreground.xml.

  Inside the adaptive icon's safe circle, 66dp across the middle of 108, because the launcher
  may mask the icon to any shape it likes.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#0A0A0A"
        android:pathData="M24,30 L84,30 L84,78 L24,78 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M24,30 L81,30 L81,33 L27,33 L27,75 L24,75 Z" />
    <path
        android:fillColor="#8D8985"
        android:pathData="M27,72 L78,72 L78,33 L81,33 L81,75 L27,75 Z" />
    <path
        android:fillColor="#E9E7E3"
        android:pathData="M27,33 L78,33 L78,36 L30,36 L30,72 L27,72 Z" />
    <path
        android:fillColor="#D3CEC7"
        android:pathData="M30,36 L78,36 L78,72 L30,72 Z" />
</vector>
